<section id="faq" class="section faq">
  <div class="container container--narrow">
    <header class="section-head">
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="h1" data-reveal>{{ section.settings.heading }}</h2>
    </header>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq-item" data-reveal {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.q }}</span><span class="faq-item__icon" aria-hidden="true"></span></summary>
          <div class="faq-item__a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you might ask." }
  ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" }
    ] }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
