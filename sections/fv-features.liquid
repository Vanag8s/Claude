<section id="benefits" class="section features">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      <h2 class="h1" data-reveal>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead" data-reveal>{{ section.settings.text }}</p>{%- endif -%}
    </header>

    <div class="feature-grid">
      {%- for block in section.blocks -%}
        <article class="feature-card" data-tilt data-reveal style="--d: {{ forloop.index0 | times: 60 }}ms" {{ block.shopify_attributes }}>
          <div class="feature-card__glow" aria-hidden="true"></div>
          <div class="feature-card__icon" aria-hidden="true">{% render 'fv-icon', name: block.settings.icon %}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefit cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Every benefit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the worst mornings of the year." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "snow",
          "options": [
            { "value": "snow", "label": "Snow" }, { "value": "sun", "label": "Sun" }, { "value": "shield", "label": "Shield" },
            { "value": "clock", "label": "Clock" }, { "value": "lock", "label": "Lock" }, { "value": "mirror", "label": "Mirror" },
            { "value": "drop", "label": "Drop" }, { "value": "fold", "label": "Fold" }, { "value": "car", "label": "Car" },
            { "value": "reflect", "label": "Reflective" }, { "value": "leaf", "label": "Leaf" }, { "value": "wind", "label": "Wind" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Benefit cards" }]
}
{% endschema %}
