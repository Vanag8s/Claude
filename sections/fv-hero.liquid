{%- comment -%}
  Cinematic scroll story built from real product photography.
  A pinned stage cross-fades "scenes" as you scroll (assets/story.js):
  product reveal → frozen glass → install callouts → overnight snow →
  before/after wipe → summer sun. Chapter copy is editable below.
{%- endcomment -%}
<section id="story" class="story" data-story style="--story-length: {{ section.settings.length }}vh">
  <div class="story__stage">
    <div class="story__bg" aria-hidden="true">
      <div class="aurora aurora--a"></div>
      <div class="aurora aurora--b"></div>
      <div class="story__sun"></div>
    </div>
    <canvas class="story__snow" data-snow aria-hidden="true"></canvas>

    <div class="scenes" aria-hidden="true">
      {%- comment -%} Product scene (intro, fix, overnight, summer) {%- endcomment -%}
      <div class="scene scene--product" data-scene="0,0.135|0.30,0.64|0.78,1">
        <div class="product-float" data-float>
          <div class="product-float__glow"></div>
          <img class="product-float__img" src="{{ 'fv-cover-cutout.webp' | asset_url }}" alt="" width="1501" height="764" fetchpriority="high">
          <div class="product-float__snow"></div>
          <div class="product-float__shine"></div>
          <div class="product-float__reflection"></div>
        </div>

        <div class="callouts" data-scene-inner="0.33,0.49">
          <div class="callout callout--mirror"><span class="callout__dot"></span><span class="callout__line"></span><span class="callout__label"><b>Mirror pockets</b>Elastic fit + reflective band</span></div>
          <div class="callout callout--trim"><span class="callout__dot"></span><span class="callout__line"></span><span class="callout__label"><b>Hi-vis lime trim</b>Easy to spot, easy to center</span></div>
          <div class="callout callout--quilt"><span class="callout__dot"></span><span class="callout__line"></span><span class="callout__label"><b>3-layer quilted shell</b>Nano-coat · Oxford · PVC</span></div>
          <div class="callout callout--flap"><span class="callout__dot"></span><span class="callout__line"></span><span class="callout__label"><b>Door-tuck flaps</b>Locked in by your doors</span></div>
        </div>
      </div>

      {%- comment -%} Frozen windshield (problem) + before/after wipe (morning) {%- endcomment -%}
      <div class="scene scene--glass" data-scene="0.135,0.30|0.64,0.78">
        <div class="glass-frame" data-wipe-range="0.655,0.755">
          <img class="glass-frame__img" src="{{ 'fv-before.webp' | asset_url }}" alt="" width="1392" height="492" loading="lazy">
          <div class="glass-frame__after">
            <img class="glass-frame__img" src="{{ 'fv-after.webp' | asset_url }}" alt="" width="1392" height="492" loading="lazy">
          </div>
          <div class="glass-frame__wipe"><span></span></div>
          <span class="glass-frame__tag glass-frame__tag--before">Without cover</span>
          <span class="glass-frame__tag glass-frame__tag--after">With Frostveil</span>
        </div>
      </div>
    </div>

    <div class="story__vignette" aria-hidden="true"></div>

    <div class="story__hud" aria-hidden="true">
      <div class="hud-chip"><span class="hud-chip__dot"></span><span data-hud-label>Tonight</span></div>
      <div class="hud-readout">
        <div><small>Outside</small><strong data-hud-temp>-12°C</strong></div>
        <div><small>Time</small><strong data-hud-time>22:00</strong></div>
        <div><small>Glass</small><strong data-hud-glass>Clear</strong></div>
      </div>
    </div>

    <div class="story__chapters">
      <div class="chapter chapter--intro" data-chapter="0" data-from="0" data-to="0.13">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h1 class="display">{{ section.settings.title }}</h1>
        <p class="lead">{{ section.settings.subtitle }}</p>
        <div class="chapter__cta">
          <a href="#buy" class="btn btn--lime btn--glow">{{ section.settings.cta }}</a>
          <span class="scroll-hint"><span></span>Scroll to see it work</span>
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div class="chapter chapter--side" data-chapter="{{ forloop.index }}" data-from="{{ block.settings.from | divided_by: 100.0 }}" data-to="{{ block.settings.to | divided_by: 100.0 }}" {{ block.shopify_attributes }}>
          <p class="eyebrow"><span class="chapter__num">0{{ forloop.index }}</span> {{ block.settings.kicker }}</p>
          <h2 class="h1">{{ block.settings.heading }}</h2>
          <p class="lead">{{ block.settings.text }}</p>
          {%- if block.settings.stat != blank -%}
            <p class="stat"><strong>{{ block.settings.stat }}</strong><span>{{ block.settings.stat_label }}</span></p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <ol class="story__progress" aria-hidden="true">
      <li data-dot="0"></li>
      {%- for block in section.blocks -%}<li data-dot="{{ forloop.index }}"></li>{%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Cinematic scroll story",
  "class": "section-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "3-Layer All-Season Windshield Cover" },
    { "type": "text", "id": "title", "label": "Title", "default": "Wake up to clear glass." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "No scraping. No de-icer. No waiting for the defrost. Frostveil wraps your windshield, front side windows and mirrors — and peels off in seconds." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Get yours" },
    { "type": "range", "id": "length", "label": "Story scroll length (vh)", "min": 400, "max": 1000, "step": 50, "default": 650 }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "stat", "label": "Stat value" },
        { "type": "text", "id": "stat_label", "label": "Stat label" },
        { "type": "range", "id": "from", "label": "Show from (% of story)", "min": 0, "max": 100, "step": 1, "default": 15 },
        { "type": "range", "id": "to", "label": "Hide at (% of story)", "min": 0, "max": 100, "step": 1, "default": 30 }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Cinematic scroll story" }]
}
{% endschema %}
