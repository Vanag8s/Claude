<section id="layers" class="layers" data-layers>
  <div class="layers__stage">
    <div class="container layers__grid">
      <div class="layers__visual" aria-hidden="true">
        <div class="stack" data-stack>
          <div class="sheet sheet--1" style="--tex: url('{{ 'fv-tex-nano.webp' | asset_url }}')"><span class="sheet__tag">L1 · Nano-coating</span><i class="sheet__drops"></i></div>
          <div class="sheet sheet--2" style="--tex: url('{{ 'fv-tex-oxford.webp' | asset_url }}')"><span class="sheet__tag">L2 · Oxford</span></div>
          <div class="sheet sheet--3" style="--tex: url('{{ 'fv-tex-pvc.webp' | asset_url }}')"><span class="sheet__tag">L3 · Non-slip PVC</span></div>
        </div>
        <div class="layers__ring"></div>
      </div>

      <div class="layers__copy">
        <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        <h2 class="h1" data-reveal>{{ section.settings.heading }}</h2>
        <p class="lead" data-reveal>{{ section.settings.text }}</p>

        <ol class="layer-list">
          {%- for block in section.blocks -%}
            <li class="layer-item" data-layer-item="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <span class="layer-item__idx">L{{ forloop.index }}</span>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p class="layer-item__role">{{ block.settings.role }}</p>
                <p class="muted">{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "3D fabric layers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three layers. Zero bulk." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Not thick cotton or sponge that soaks up water and freezes stiff. Frostveil insulates through its structure — a light, laminated composite that folds flat for storage." }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "3D fabric layers" }]
}
{% endschema %}
