<section class="section page-simple">
  <div class="container container--narrow">
    <h1 class="h1">{{ blog.title }}</h1>
    {%- for a in blog.articles -%}
      <article class="blog-item"><a class="h3" href="{{ a.url }}">{{ a.title }}</a><p class="muted">{{ a.excerpt_or_content | strip_html | truncatewords: 30 }}</p></article>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
